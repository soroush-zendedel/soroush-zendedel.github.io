# LITELLM:
LITELLM_MASTER_KEY=...
# LITELLM_MASTER_KEY automatically will generate and copy in your clipbord for using in your VSCODE plugins - .vscode tasks
LITELLM_SALT_KEY=...
# Generate with this command:
# python -c "import secrets; print(secrets.token_urlsafe(32))"

# DATABASE:
# DATABASE_URL=postgresql://litellm:YOUR_PASSWORD@localhost:5432/litellm
# Database string will set by docker-compose
# SQLITE is not recommended by docs but:
# DATABASE_URL=sqlite:///./litellm.db

UI_USERNAME=admin
UI_PASSWORD=YOUR_PASSWORD

GEMINI_API_KEY=your-gemini-key
GEMINI_API_KEY_2=your-gemini-key
GEMINI_API_KEY_3=your-gemini-key
GEMINI_API_KEY_4=your-gemini-key
GEMINI_API_KEY_5=your-gemini-key
GEMINI_API_KEY_6=your-gemini-key


OPENAI_API_KEY=your-openai-key
ANTHROPIC_API_KEY=your-anthropic-key